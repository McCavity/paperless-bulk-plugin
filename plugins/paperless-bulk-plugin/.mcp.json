{
  "mcpServers": {
    "paperless-bulk": {
      "command": "python3",
      "args": ["-m", "paperless_bulk_mcp"],
      "env": {
        "PAPERLESS_BASE_URL": "${PAPERLESS_BASE_URL}",
        "PAPERLESS_TOKEN": "${PAPERLESS_TOKEN}",
        "PAPERLESS_INBOX_TAG_ID": "${PAPERLESS_INBOX_TAG_ID}"
      }
    }
  }
}
